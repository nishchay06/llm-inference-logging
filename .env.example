# Copy this file to .env and fill in your real key:
#   cp .env.example .env
#
# Get a key at https://console.anthropic.com/  (Settings → API Keys).
# .env is gitignored, so your real key never gets committed.
ANTHROPIC_API_KEY=sk-ant-...

# Where the chatbot ships inference logs. Defaults to the local ingestion
# service if unset.
INGESTION_URL=http://127.0.0.1:8001/logs

# Postgres connection (SQLAlchemy URL, psycopg v3 driver). If unset, defaults to
# postgresql+psycopg://<your-os-user>@localhost:5432/chatbot
DATABASE_URL=postgresql+psycopg://USER@localhost:5432/chatbot
