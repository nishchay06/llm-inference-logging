# Copy this file to .env and fill in your real key:
#   cp .env.example .env
#
# Get a key at https://console.anthropic.com/  (Settings → API Keys).
# .env is gitignored, so your real key never gets committed.
ANTHROPIC_API_KEY=sk-ant-...

# LLM provider selection. LLM_PROVIDER is "anthropic" (default) or "gemini";
# LLM_MODEL overrides the per-provider default (claude-sonnet-5 / gemini-flash-latest).
LLM_PROVIDER=anthropic
# LLM_MODEL=

# How inference calls are instrumented. "patch" (default) auto-instruments by
# monkey-patching the provider SDK; "wrapper" uses the explicit TracedClient.
# Both capture identical fields — see docs/auto-instrumentation.md.
# LLM_INSTRUMENTATION=patch

# Only needed when LLM_PROVIDER=gemini. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Where the chatbot ships inference logs. Defaults to the local ingestion
# service if unset.
INGESTION_URL=http://127.0.0.1:8001/logs

# Optional event-based transport. If set, the chatbot publishes logs to a Redis
# Stream and a separate worker (python -m ingestion.worker) consumes them —
# durable across an ingestion outage. If unset, logs go via HTTP (INGESTION_URL).
# REDIS_URL=redis://localhost:6379/0

# Postgres connection (SQLAlchemy URL, psycopg v3 driver). If unset, defaults to
# postgresql+psycopg://<your-os-user>@localhost:5432/chatbot
DATABASE_URL=postgresql+psycopg://USER@localhost:5432/chatbot
